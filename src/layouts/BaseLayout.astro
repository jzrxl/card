---
const { title = "Jezrel Palabrica", description = "Portfolio of Jezrel Palabrica" } = Astro.props;
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060a0a" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- OG Tags -->
    <meta property="og:title" content="Jezrel Palabrica" />
    <meta property="og:description" content="IT Support · Remote-Ready. Self-taught tech generalist from the Philippines." />
    <meta property="og:image" content="https://jezrelcrd.vercel.app/images/profile2.webp" />
    <meta property="og:url" content="https://jezrelcrd.vercel.app/" />
    <meta property="og:type" content="website" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jezrel Palabrica" />
    <meta name="twitter:description" content="IT Support · Remote-Ready. Self-taught tech generalist from the Philippines." />
    <meta name="twitter:image" content="https://jezrelcrd.vercel.app/images/profile2.webp" />

    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>