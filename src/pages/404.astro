---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | Jezrel" description="Page not found.">
  <div class="error-container">
    <div class="error-content">
      <p class="error-label">// 404</p>
      <h1 class="error-code">Lost?</h1>
      <p class="error-msg">That page doesn't exist or was moved.</p>
      <a href="/" class="back-btn">← Back to home</a>
    </div>
  </div>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@800&family=JetBrains+Mono:wght@400;500&display=swap');

  .error-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #060a0a;
    padding: 24px;
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .error-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #0ec4b8;
    letter-spacing: 0.12em;
    opacity: 0.8;
  }

  .error-code {
    font-family: 'Syne', sans-serif;
    font-size: 72px;
    font-weight: 800;
    margin: 0;
    color: #f0fffe;
    letter-spacing: -2px;
    line-height: 1;
  }

  .error-msg {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: rgba(240, 255, 254, 0.5);
  }

  .back-btn {
    margin-top: 8px;
    padding: 10px 24px;
    border: 1px solid rgba(14, 196, 184, 0.25);
    border-radius: 20px;
    color: rgba(240, 255, 254, 0.75);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .back-btn:hover {
    color: #0ec4b8;
    border-color: #0ec4b8;
  }

  @media (max-width: 400px) {
    .error-code { font-size: 52px; }
  }
</style>