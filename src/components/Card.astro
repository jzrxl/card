---
const { name, position, aboutMe, linkedin, github, facebook, email, cvLink, profileImage } = Astro.props;
import '../styles/card.css';
---

<canvas id="starCanvas"></canvas>
<div class="cursor-dot"></div>
<div class="cursor-outline"></div>

<div class="container">
  <div class="main-wrapper">

    <div class="card-container">
      <div class="descripcion">

        <div class="name-status">
          <h1>{name}</h1>
          <div class="status-indicator" data-tooltip="Available for hire">
            <span class="status-dot"></span>
            <span class="status-pulse"></span>
          </div>
        </div>

        <div class="title-container">
          <h2 id="typewriter-title" data-text={position}></h2>
        </div>

        <div class="about-container">
          <p class="about-text" set:html={aboutMe}></p>
        </div>

        <div class="social-footer">
          <div class="icons">
            {facebook && (
              <a href={facebook} class="social-icon" target="_blank" rel="noopener" data-tooltip="Facebook">
                <i class="bi bi-facebook"></i>
              </a>
            )}
            {github && (
              <a href={github} class="social-icon" target="_blank" rel="noopener" data-tooltip="GitHub">
                <i class="bi bi-github"></i>
              </a>
            )}
            {linkedin && (
              <a href={linkedin} class="social-icon" target="_blank" rel="noopener" data-tooltip="LinkedIn">
                <i class="bi bi-linkedin"></i>
              </a>
            )}
            {cvLink && (
              <a href={cvLink} class="social-icon" target="_blank" rel="noopener" data-tooltip="Resume">
                <i class="bi bi-file-earmark-person"></i>
              </a>
            )}
            {email && (
              <div class="social-icon copy-email-btn" data-email={email} role="button" tabindex="0" data-tooltip="Copy email">
                <i class="bi bi-envelope"></i>
              </div>
            )}
          </div>
        </div>

      </div>

      <div class="image">
        <div class="img-wrapper">
          <img src={profileImage} alt={`${name} profile photo`} loading="eager" />
        </div>
      </div>
    </div>

    <div id="skills-panel" class="skills-panel">
      <div class="panel-inner">
        <p class="panel-label">// skills & tools</p>
        <div class="tech-stack">
          <span class="tag">Arch Linux</span>
          <span class="tag">CachyOS</span>
          <span class="tag">Windows 10/11</span>
          <span class="tag">Bash Scripting</span>
          <span class="tag">Python</span>
          <span class="tag">Systemd</span>
          <span class="tag">Proton / Wine</span>
          <span class="tag">Hardware Diagnostics</span>
          <span class="tag">Driver Troubleshooting</span>
          <span class="tag">Networking</span>
          <span class="tag">HTML / CSS</span>
          <span class="tag">Astro</span>
          <span class="tag">Git / GitHub</span>
          <span class="tag">Written Communication</span>
          <span class="tag">Remote Work Ready</span>
          <span class="tag">QA / Data Entry</span>
        </div>
      </div>
    </div>

    <div class="trigger-wrapper">
      <button id="toggle-skills" class="skills-cta">
        <i class="bi bi-chevron-down arrow-icon"></i>
        <span id="cta-text">skills &amp; tools</span>
        <i class="bi bi-chevron-down arrow-icon"></i>
      </button>
    </div>

  </div>
</div>

<script>
function initAll() {
  // detect touch/mobile — skip canvas and cursor entirely
  const isMobile = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  const canvas  = document.getElementById('starCanvas') as HTMLCanvasElement | null;
  const dot     = document.querySelector('.cursor-dot')     as HTMLElement | null;
  const outline = document.querySelector('.cursor-outline') as HTMLElement | null;

  if (isMobile) {
    // hide canvas and cursors, restore default cursor
    if (canvas)  canvas.style.display  = 'none';
    if (dot)     dot.style.display     = 'none';
    if (outline) outline.style.display = 'none';
    document.body.style.cursor = 'auto';
  } else {
    // desktop: run particles and custom cursor
    if (canvas) {
      const ctx = canvas.getContext('2d')!;
      let particles: Particle[] = [];
      const mouse = { x: -9999, y: -9999, radius: 120 };

      class Particle {
        x: number; y: number; bx: number; by: number;
        size: number; density: number; vx: number; vy: number;
        constructor(x: number, y: number) {
          this.x = this.bx = x; this.y = this.by = y;
          this.size    = Math.random() * 1 + 0.3;
          this.density = Math.random() * 12 + 1;
          this.vx      = (Math.random() - 0.5) * 0.08;
          this.vy      = (Math.random() - 0.5) * 0.08;
        }
        draw() {
          ctx.fillStyle = 'rgba(255,255,255,0.45)';
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fill();
        }
        update() {
          this.bx += this.vx; this.by += this.vy;
          if (this.bx < 0) this.bx = canvas.width;
          if (this.bx > canvas.width)  this.bx = 0;
          if (this.by < 0) this.by = canvas.height;
          if (this.by > canvas.height) this.by = 0;

          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouse.radius && dist > 0) {
            const f = (mouse.radius - dist) / mouse.radius;
            this.x += (dx / dist) * f * this.density * 0.18;
            this.y += (dy / dist) * f * this.density * 0.18;
          } else {
            this.x += (this.bx - this.x) / 22;
            this.y += (this.by - this.y) / 22;
          }
        }
      }

      const resize = () => {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
        particles = [];
        const n = Math.floor((canvas.width * canvas.height) / 16000);
        for (let i = 0; i < n; i++)
          particles.push(new Particle(Math.random() * canvas.width, Math.random() * canvas.height));
      };

      const animate = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(p => { p.update(); p.draw(); });
        requestAnimationFrame(animate);
      };

      window.addEventListener('resize', resize);
      resize(); animate();
    }

    // custom cursor only on desktop
    window.addEventListener('mousemove', e => {
      mouse.x = e.clientX; mouse.y = e.clientY;
      if (dot && outline) {
        dot.style.left = `${e.clientX}px`;
        dot.style.top  = `${e.clientY}px`;
        outline.animate(
          { left: `${e.clientX}px`, top: `${e.clientY}px` },
          { duration: 450, fill: 'forwards' }
        );
      }
    });

    document.querySelectorAll('a, button, .social-icon, .tag').forEach(el => {
      el.addEventListener('mouseenter', () => outline?.classList.add('hovering'));
      el.addEventListener('mouseleave', () => outline?.classList.remove('hovering'));
    });
  }

  // typewriter runs on both
  const titleEl = document.getElementById('typewriter-title') as HTMLElement | null;
  if (titleEl) {
    const text = titleEl.getAttribute('data-text') ?? '';
    titleEl.textContent = '';
    let i = 0;
    const type = () => {
      if (i < text.length) { titleEl.textContent += text[i++]; setTimeout(type, 80); }
    };
    setTimeout(type, 350);
  }

  // skills toggle runs on both
  const toggleBtn = document.getElementById('toggle-skills');
  const panel     = document.getElementById('skills-panel');
  const ctaText   = document.getElementById('cta-text');
  toggleBtn?.addEventListener('click', () => {
    const opening = panel?.classList.toggle('active');
    toggleBtn.classList.toggle('is-open');
    if (ctaText) ctaText.textContent = opening ? 'hide' : 'skills & tools';
  });

  // copy email runs on both
  const copyBtn = document.querySelector('.copy-email-btn');
  copyBtn?.addEventListener('click', () => {
    const addr = copyBtn.getAttribute('data-email');
    if (!addr) return;
    navigator.clipboard.writeText(addr).then(() => {
      const orig = copyBtn.getAttribute('data-tooltip') ?? 'Copy email';
      copyBtn.setAttribute('data-tooltip', 'Copied!');
      setTimeout(() => copyBtn.setAttribute('data-tooltip', orig), 2000);
    });
  });
  copyBtn?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') (copyBtn as HTMLElement).click();
  });
}

initAll();
document.addEventListener('astro:after-swap', initAll);
</script>